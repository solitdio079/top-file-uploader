

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Top Upload - Login</title>
  <link rel="stylesheet" href="/styles/auth.css">
</head>

<body>
  <div class="page">
    <header class="header">
      <nav class="nav">
       <a href="/"><img src="/images/logo.png" alt="Logo" class="logo"></a> 
      </nav>
    </header>

    <div class="main">
      <h1 class="title">Create your account</h1>
      <p class="subtitle">Start organizing your files in one place</p>

         <% if (message) { %>
      <p class="error"><%= message %></p>
      <% } %>

      <form action="/auth/signup" method="post">
        <section class="form-section">
          <label for="username">Username</label>
          <input id="username" name="username" type="text" autocomplete="username" placeholder="Enter your username" required autofocus>
        </section>
        <section class="form-section">
          <label for="current-password">Password</label>
          <input id="current-password" name="password" type="password" autocomplete="current-password" required>
        </section>

          <section class="form-section">
          <label for="confirm-password">Confirm Password</label>
          <input id="confirm-password" name="confirmPassword" type="password" autocomplete="current-password" required>
        </section>
        <section class="form-section remember-me">
          <label for="remember-me">
            <input id="remember-me" name="remember-me" type="checkbox">
            I agree to the <a href="/terms">terms and conditions</a>
          </label>

         
        </section>
        <button class="submit-button btn btn-primary" type="submit">Sign Up</button>
      </form>
      <div class="register"> <span><hr>Already have an account?<hr></span>  <a class="register-link btn btn-outline" href="/auth/login">Sign In instead</a></div>
     
    
    </div>



  </div>

<script>
    const errorElement = document.querySelector('.error');
    if(errorElement.textContent) {
        setTimeout(() => {
            errorElement.remove();
        }, 5000);
    }

</script>

</body>

</html>